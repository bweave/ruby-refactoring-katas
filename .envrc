#!/bin/bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

# Install gems into vendor/bundle (outside GEM_PATH) so Bundler doesn't scan
# stdlib gem stubs in the Nix Ruby and emit "missing extensions" warnings.
#
# TODO: the conventional home for this is .bundle/config (BUNDLE_PATH key) so
# it works outside the devbox shell too. Move it there once the global Edit
# deny rule on .bundle/config is lifted; then drop this export.
export BUNDLE_PATH="vendor/bundle"
